{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/index.php" },
    { "source": "/index.php", "destination": "/api/index.php" },
    { "source": "/dashboard.php", "destination": "/api/dashboard.php" },
    { "source": "/dashboard-admin.php", "destination": "/api/dashboard-admin.php" },
    { "source": "/dashboard-client-basic.php", "destination": "/api/dashboard-client-basic.php" },
    { "source": "/dashboard-client-standard.php", "destination": "/api/dashboard-client-standard.php" },
    { "source": "/dashboard-referral.php", "destination": "/api/dashboard-referral.php" },
    { "source": "/dashboard-client.php", "destination": "/api/dashboard-client.php" },
    { "source": "/logout.php", "destination": "/api/logout.php" },
    { "source": "/diag.php", "destination": "/api/diag.php" }
  ]
}
