{
  "buildCommand": "mkdir -p public/assets && cp -R assets/. public/assets/",
  "outputDirectory": "public",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/index.php" },
    { "source": "/index.php", "destination": "/api/index.php" },
    { "source": "/dashboard.php", "destination": "/api/index.php" },
    { "source": "/dashboard-admin.php", "destination": "/api/dashboard-admin.php" },
    { "source": "/dashboard-client-basic.php", "destination": "/api/index.php" },
    { "source": "/dashboard-client-standard.php", "destination": "/api/index.php" },
    { "source": "/dashboard-referral.php", "destination": "/api/index.php" },
    { "source": "/dashboard-client.php", "destination": "/api/dashboard-client.php" },
    { "source": "/logout.php", "destination": "/api/logout.php" },
    { "source": "/session.php", "destination": "/api/notifications.php" },
    { "source": "/pending.php", "destination": "/api/pending.php" },
    { "source": "/notifications.php", "destination": "/api/notifications.php" },
    { "source": "/business.php", "destination": "/api/business.php" },
    { "source": "/kyc.php", "destination": "/api/kyc.php" },
    { "source": "/dashboard-affiliate.php", "destination": "/api/dashboard-affiliate.php" },
    { "source": "/terms.php", "destination": "/api/terms.php" },
    { "source": "/work.php", "destination": "/api/work.php" },
    { "source": "/report.php", "destination": "/api/report.php" }
  ]
}
